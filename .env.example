DATABASE=mongodb_connection_string
# Optional comma-separated DNS servers. Leave empty to use the system resolver.
DNS_SERVERS=
JWTSECRET=replace_with_a_long_random_secret
NODE_ENV=development
# Development-only demo accounts. Never enable these in production.
SEED_DEMO_USERS=false
DEMO_USER_PASSWORD=Demo123!
DEMO_USER_1_NAME=Alice Demo
DEMO_USER_1_EMAIL=alice.demo@mechat.local
DEMO_USER_2_NAME=Bob Demo
DEMO_USER_2_EMAIL=bob.demo@mechat.local
DEMO_USER_3_NAME=Charlie Demo
DEMO_USER_3_EMAIL=charlie.demo@mechat.local
GOOGLE_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com
# Comma-separate localhost and deployed frontend origins in production.
CLIENT_ORIGINS=http://localhost:3000
